---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
}

const { href, class: className = '', ...props } = Astro.props;

// Check if link starts with external protocols
const isExternal = typeof href === 'string' && /^(https?:)?\/\//i.test(href);
---

<a
  href={href}
  class:list={[
    "inline-inline items-baseline text-[#58a6ff] hover:underline underline-offset-2 transition-colors",
    isExternal ? "external-link group/link" : "internal-link",
    className
  ]}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  {...props}
><slot />{isExternal && (
    <span class="inline-flex items-center ml-1 text-slate-400 group-hover/link:text-[#58a6ff] transition-colors" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="inline w-3 h-3 align-baseline"
      >
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </span>
  )}</a>

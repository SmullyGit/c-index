---
interface Props {
  class?: string;
  size?: number;
}

const { class: className = '', size = 200 } = Astro.props;
---

<header class:list={["site-header not-prose mb-8 flex justify-center sm:justify-start", className]}>
  <a href="/" class="group inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:rounded-lg" aria-label="The Citizen Index Home">
    <!-- Light Mode Logo (Black) -->
    <img
      src="/c-index-logo-black.png"
      alt="The Citizen Index Logo"
      width={size}
      height={size}
      class="block dark:hidden w-[160px] h-[160px] sm:w-[200px] sm:h-[200px] object-contain transition-transform duration-200 group-hover:scale-[1.02]"
      loading="eager"
      decoding="async"
    />

    <!-- Dark Mode Logo (White) -->
    <img
      src="/c-index-logo-white.png"
      alt="The Citizen Index Logo"
      width={size}
      height={size}
      class="hidden dark:block w-[160px] h-[160px] sm:w-[200px] sm:h-[200px] object-contain transition-transform duration-200 group-hover:scale-[1.02]"
      loading="eager"
      decoding="async"
    />
  </a>
</header>
